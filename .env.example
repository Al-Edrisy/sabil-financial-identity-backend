PROJECT_NAME="Sabil Financial Identity"
VERSION="0.1.0"

# ── Database ─────────────────────────────────────────────────────────────────
# asyncpg driver is required — use postgresql+asyncpg:// prefix
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/sabil"

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY="generate-a-secure-random-secret-key-here"

# Fernet key for PII encryption at rest (id_number, nationality, OCR data)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KYC_PII_ENCRYPTION_KEY="your-base64-encoded-fernet-key"

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no spaces)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# ── Firebase ─────────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH="firebase-credentials.json"

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_BACKEND="local"           # local | s3
KYC_UPLOAD_DIR="uploads/kyc"

# ── Redis (optional — falls back to in-memory rate limiting if not set) ──────
REDIS_URL=""                      # e.g. redis://localhost:6379/0

# ── KYC Pipeline Thresholds (all optional — defaults shown) ──────────────────
KYC_FACE_MATCH_THRESHOLD="0.6"
KYC_FACE_MATCH_MANUAL_THRESHOLD="0.4"
KYC_LIVENESS_MIN_VARIANCE="80.0"
KYC_LIVENESS_MANUAL_THRESHOLD="60.0"
KYC_LIVENESS_FREQ_THRESHOLD="0.5"
KYC_REQUIRE_LIVENESS="true"
KYC_MAX_RESUBMISSIONS="3"
KYC_EXPIRY_DAYS="365"
KYC_OCR_MIN_CONFIDENCE="0.45"

# ── Webhooks ─────────────────────────────────────────────────────────────────
KYC_WEBHOOK_URL=""                # POST endpoint for KYC status change events
CREDIT_WEBHOOK_URL=""             # POST endpoint for credit score change events
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=""                 # HMAC-SHA256 signing secret for outbound webhooks

# ── Credit Scoring (Phase 1) ─────────────────────────────────────────────────
CREDIT_UPLOAD_DIR="uploads/statements"
CREDIT_SCORE_MIN_TRANSACTIONS="3"
CREDIT_SCORE_INCOME_CAP="50000.0"
CREDIT_CATEGORIZER_THRESHOLD="70"
