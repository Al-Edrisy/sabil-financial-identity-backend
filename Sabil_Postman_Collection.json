{
  "info": {
    "name": "Sabil — Financial Identity Backend",
    "_postman_id": "sabil-api-v1",
    "description": "Complete API collection for the Sabil Financial Identity Backend.\n\n**Base URL:** `http://localhost:8001/api/v1`\n\n**Authentication:** Most endpoints require `Authorization: Bearer {{access_token}}`.\nObtain a token via `POST /auth/send-otp` → `POST /auth/verify-otp`.\n\n**Dev bypass:** Phone `+96742424242` + OTP code `7744` always succeeds.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "variable": [
    { "key": "base_url",     "value": "http://localhost:8001/api/v1", "type": "string" },
    { "key": "access_token", "value": "",                             "type": "string" },
    { "key": "admin_token",  "value": "",                             "type": "string" },
    { "key": "user_id",      "value": "1",                            "type": "string" },
    { "key": "tx_id",        "value": "1",                            "type": "string" }
  ],
  "item": [

    {
      "name": "🏥 Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] },
            "description": "Returns `{\"status\": \"healthy\"}`. No auth required."
          }
        }
      ]
    },

    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "1a — Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+96742424242\",\n  \"country_code\": \"+967\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/send-otp", "host": ["{{base_url}}"], "path": ["auth","send-otp"] },
            "description": "Sends OTP to phone. Dev bypass: `+96742424242` always gets code `7744`. Rate limited: 3 req/min."
          }
        },
        {
          "name": "1b — Verify OTP (get token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.access_token) {",
                  "  pm.collectionVariables.set('access_token', r.access_token);",
                  "  pm.collectionVariables.set('user_id', r.user.id);",
                  "  console.log('✅ Token saved:', r.access_token.slice(0,20)+'...');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+96742424242\",\n  \"otp_code\": \"7744\",\n  \"full_name\": \"Test User\",\n  \"country_code\": \"+967\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/verify-otp", "host": ["{{base_url}}"], "path": ["auth","verify-otp"] },
            "description": "Verifies OTP. Returns `access_token` + user profile. Token is auto-saved to `{{access_token}}`."
          }
        },
        {
          "name": "Login via Firebase Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"<firebase_id_token_here>\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] },
            "description": "Legacy Firebase token login. Creates user + wallet on first call."
          }
        }
      ]
    },

    {
      "name": "👤 Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users","me"] },
            "description": "Returns the authenticated user's profile."
          }
        },
        {
          "name": "Get Onboarding Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/users/me/onboarding-status", "host": ["{{base_url}}"], "path": ["users","me","onboarding-status"] },
            "description": "Returns current onboarding step, KYC status, credit status, and next action URL."
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Updated Name\",\n  \"email\": \"user@example.com\",\n  \"country_code\": \"YE\"\n}"
            },
            "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users","me"] },
            "description": "Updates non-sensitive profile fields."
          }
        },
        {
          "name": "Delete My Account",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users","me"] },
            "description": "Permanently deletes account and all associated data. Returns 204."
          }
        },
        {
          "name": "[Admin] List All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": {
              "raw": "{{base_url}}/users?skip=0&limit=20",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [
                { "key": "skip",      "value": "0"    },
                { "key": "limit",     "value": "20"   },
                { "key": "email",     "value": "",     "disabled": true },
                { "key": "phone",     "value": "",     "disabled": true },
                { "key": "is_active", "value": "true", "disabled": true }
              ]
            },
            "description": "Admin only. Paginated, filterable user list."
          }
        },
        {
          "name": "[Admin] Get User by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": { "raw": "{{base_url}}/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["users","{{user_id}}"] },
            "description": "Admin only. Returns any user's profile by internal ID."
          }
        },
        {
          "name": "[Admin] Update Any User",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": true,\n  \"is_admin\": false\n}"
            },
            "url": { "raw": "{{base_url}}/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["users","{{user_id}}"] },
            "description": "Admin only. Update any user's profile or status flags."
          }
        }
      ]
    },

    {
      "name": "💰 Wallet",
      "item": [
        {
          "name": "Get Wallet Balance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/wallet/balance", "host": ["{{base_url}}"], "path": ["wallet","balance"] },
            "description": "Returns wallet balance and currency."
          }
        },
        {
          "name": "Top Up Wallet (Simulated)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500.00\n}"
            },
            "url": { "raw": "{{base_url}}/wallet/topup", "host": ["{{base_url}}"], "path": ["wallet","topup"] },
            "description": "Simulated top-up. Replace with real payment gateway in production."
          }
        },
        {
          "name": "Transfer Funds",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to_user_id\": 2,\n  \"amount\": 100.00,\n  \"description\": \"Payment for services\"\n}"
            },
            "url": { "raw": "{{base_url}}/wallet/transfer", "host": ["{{base_url}}"], "path": ["wallet","transfer"] },
            "description": "Transfers funds to another user by their ID."
          }
        },
        {
          "name": "Withdraw Funds",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50.00,\n  \"description\": \"ATM withdrawal\"\n}"
            },
            "url": { "raw": "{{base_url}}/wallet/withdraw", "host": ["{{base_url}}"], "path": ["wallet","withdraw"] },
            "description": "Executes a withdrawal from the user's wallet."
          }
        },
        {
          "name": "Get Transaction History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/wallet/history", "host": ["{{base_url}}"], "path": ["wallet","history"] },
            "description": "Returns full wallet transaction history."
          }
        },
        {
          "name": "Get Transaction Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/wallet/transactions/{{tx_id}}", "host": ["{{base_url}}"], "path": ["wallet","transactions","{{tx_id}}"] },
            "description": "Fetches details for a specific wallet transaction."
          }
        }
      ]
    },

    {
      "name": "🪪 KYC — User",
      "item": [
        {
          "name": "Submit KYC Verification",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "id_card",    "type": "file",  "description": "Government-issued ID photo (JPEG/PNG/WebP, max 10MB)" },
                { "key": "selfie",     "type": "file",  "description": "Live selfie photo" },
                { "key": "id_type",    "type": "text",  "value": "national_id", "description": "national_id | passport | driving_license | residence_permit" },
                { "key": "full_name",  "type": "text",  "value": "", "disabled": true, "description": "Manual override — Full name as on document" },
                { "key": "id_number",  "type": "text",  "value": "", "disabled": true, "description": "Manual override — ID/Passport number" },
                { "key": "issue_date", "type": "text",  "value": "", "disabled": true, "description": "Manual override — YYYY-MM-DD" },
                { "key": "expiry_date","type": "text",  "value": "", "disabled": true, "description": "Manual override — YYYY-MM-DD" },
                { "key": "country",    "type": "text",  "value": "", "disabled": true, "description": "Manual override — e.g. YE, SA" },
                { "key": "nationality","type": "text",  "value": "", "disabled": true, "description": "Manual override — e.g. Yemeni" }
              ]
            },
            "url": { "raw": "{{base_url}}/kyc/verify", "host": ["{{base_url}}"], "path": ["kyc","verify"] },
            "description": "Step 2 — Upload ID + selfie. OCR, liveness, and face match are run automatically. Manual fields override OCR when provided."
          }
        },
        {
          "name": "Resubmit KYC (after rejection)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "id_card", "type": "file", "description": "Updated ID photo" },
                { "key": "selfie",  "type": "file", "description": "New selfie" },
                { "key": "id_type", "type": "text", "value": "national_id" }
              ]
            },
            "url": { "raw": "{{base_url}}/kyc/resubmit", "host": ["{{base_url}}"], "path": ["kyc","resubmit"] },
            "description": "Re-attempt after REJECTED status. Capped by KYC_MAX_RESUBMISSIONS."
          }
        },
        {
          "name": "Get KYC Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/kyc/status", "host": ["{{base_url}}"], "path": ["kyc","status"] },
            "description": "Returns most recent active KYC record."
          }
        },
        {
          "name": "Get KYC History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/kyc/history", "host": ["{{base_url}}"], "path": ["kyc","history"] },
            "description": "Returns all past KYC attempts including rejections."
          }
        },
        {
          "name": "Debug: Inspect OCR Output (ID)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "id_card", "type": "file", "description": "ID image to inspect" },
                { "key": "id_type", "type": "text", "value": "national_id" }
              ]
            },
            "url": { "raw": "{{base_url}}/kyc/debug-ocr", "host": ["{{base_url}}"], "path": ["kyc","debug-ocr"] },
            "description": "Runs OCR on ID image and returns raw tokens, field extraction, MRZ. No data saved."
          }
        }
      ]
    },

    {
      "name": "🛡️ Admin — KYC",
      "item": [
        {
          "name": "[Admin] List KYC Applications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": {
              "raw": "{{base_url}}/admin/kyc/list?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["admin","kyc","list"],
              "query": [
                { "key": "page",         "value": "1"  },
                { "key": "page_size",    "value": "20" },
                { "key": "status",       "value": "",   "disabled": true, "description": "pending | verified | rejected | resubmitted" },
                { "key": "expired_only", "value": "false", "disabled": true },
                { "key": "user_id",      "value": "",   "disabled": true },
                { "key": "id_number",    "value": "",   "disabled": true, "description": "Partial ID number search" }
              ]
            },
            "description": "Paginated, filterable KYC application list."
          }
        },
        {
          "name": "[Admin] Submit Manual KYC Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approved\": true,\n  \"note\": \"Documents verified manually. All checks passed.\"\n}"
            },
            "url": { "raw": "{{base_url}}/admin/kyc/{{user_id}}/review", "host": ["{{base_url}}"], "path": ["admin","kyc","{{user_id}}","review"] },
            "description": "Manually approve or reject a KYC application. Set `approved: false` to reject."
          }
        }
      ]
    },

    {
      "name": "📊 Credit Scoring — User",
      "item": [
        {
          "name": "List Supported Currencies",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/credit/currencies", "host": ["{{base_url}}"], "path": ["credit","currencies"] },
            "description": "Returns all currencies supported for financial document processing with exchange rates. No auth required."
          }
        },
        {
          "name": "Upload Financial Documents (Step 3)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "files",        "type": "file", "description": "Bank statement image/PDF/CSV/TXT (max 25MB each). Add multiple `files` entries for batch." },
                { "key": "user_country", "type": "text", "value": "YE", "disabled": true, "description": "ISO country code for currency conversion (e.g. YE, SA, TR)" }
              ]
            },
            "url": { "raw": "{{base_url}}/credit/upload", "host": ["{{base_url}}"], "path": ["credit","upload"] },
            "description": "Step 3 — Upload one or more bank statements. OCR + transaction parsing + credit scoring runs automatically."
          }
        },
        {
          "name": "Get Latest Credit Score",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/credit/score", "host": ["{{base_url}}"], "path": ["credit","score"] },
            "description": "Returns the most recent active credit score with signals and insights."
          }
        },
        {
          "name": "List Parsed Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{base_url}}/credit/transactions?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["credit","transactions"],
              "query": [
                { "key": "page",         "value": "1"  },
                { "key": "page_size",    "value": "20" },
                { "key": "type",         "value": "",   "disabled": true, "description": "income | expense | unknown" },
                { "key": "needs_review", "value": "",   "disabled": true, "description": "true | false" }
              ]
            },
            "description": "Paginated parsed transactions. Filter by type or review flag."
          }
        },
        {
          "name": "Get Transactions Flagged for Review",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/credit/transactions/review", "host": ["{{base_url}}"], "path": ["credit","transactions","review"] },
            "description": "Returns all transactions that need human review (needs_review=true)."
          }
        },
        {
          "name": "Correct a Parsed Transaction",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1500.00,\n  \"description\": \"Salary payment\",\n  \"type\": \"income\",\n  \"category\": \"salary\"\n}"
            },
            "url": { "raw": "{{base_url}}/credit/transactions/{{tx_id}}/correct", "host": ["{{base_url}}"], "path": ["credit","transactions","{{tx_id}}","correct"] },
            "description": "Fix a misparse. Triggers automatic score recomputation. Returns updated CreditScoreResponse."
          }
        },
        {
          "name": "Debug: Inspect OCR + Parser Output",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "statement", "type": "file", "description": "Bank statement image to inspect" }
              ]
            },
            "url": { "raw": "{{base_url}}/credit/debug-ocr", "host": ["{{base_url}}"], "path": ["credit","debug-ocr"] },
            "description": "Inspect OCR tokens and transaction parser classification. No DB writes."
          }
        }
      ]
    },

    {
      "name": "🛡️ Admin — Credit",
      "item": [
        {
          "name": "[Admin] List All Credit Scores",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": {
              "raw": "{{base_url}}/admin/credit/list?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["admin","credit","list"],
              "query": [
                { "key": "page",       "value": "1"  },
                { "key": "page_size",  "value": "20" },
                { "key": "risk_level", "value": "",   "disabled": true, "description": "trusted | moderate | risky" }
              ]
            },
            "description": "Paginated list of all users' active credit scores. Filter by risk_level."
          }
        },
        {
          "name": "[Admin] Get User's Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": {
              "raw": "{{base_url}}/admin/credit/users/{{user_id}}/transactions?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["admin","credit","users","{{user_id}}","transactions"],
              "query": [
                { "key": "page",      "value": "1"  },
                { "key": "page_size", "value": "20" }
              ]
            },
            "description": "Admin view of any user's parsed transactions."
          }
        },
        {
          "name": "[Admin] Force Recompute Credit Score",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": { "raw": "{{base_url}}/admin/credit/users/{{user_id}}/rescore", "host": ["{{base_url}}"], "path": ["admin","credit","users","{{user_id}}","rescore"] },
            "description": "Recomputes credit score from all existing parsed transactions."
          }
        },
        {
          "name": "[Admin] Global Review Queue",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": {
              "raw": "{{base_url}}/admin/credit/review-queue?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["admin","credit","review-queue"],
              "query": [
                { "key": "page",      "value": "1"  },
                { "key": "page_size", "value": "20" }
              ]
            },
            "description": "All needs_review=true rows across ALL users."
          }
        },
        {
          "name": "[Admin] Resolve a Flagged Transaction",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": {
              "raw": "{{base_url}}/admin/credit/transactions/{{tx_id}}/resolve",
              "host": ["{{base_url}}"],
              "path": ["admin","credit","transactions","{{tx_id}}","resolve"],
              "query": [
                { "key": "correct_type",     "value": "income", "disabled": true, "description": "income | expense | unknown" },
                { "key": "correct_category", "value": "",       "disabled": true }
              ]
            },
            "description": "Mark a needs_review row as resolved. Optionally correct type/category."
          }
        }
      ]
    }

  ]
}